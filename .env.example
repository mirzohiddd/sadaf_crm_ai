# ════════════════════════════════════════════════════════════════
#  SADAF CRM — backend sozlamalari
#  Nusxa oling:  cp .env.example .env   — va qiymatlarni to'ldiring.
#  .env faylini HECH QACHON gitga/ZIPga qo'shmang (.gitignore da bor).
# ════════════════════════════════════════════════════════════════

# ——— Auth ———
# Yangi kalit yarating:  openssl rand -hex 32
JWT_SECRET=change-me-run-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=720
# Birinchi Super Admin (faqat users.json da Super Admin bo'lmasa yaratiladi)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Bosh Menejer
# Eski moslik: "menejer"/"12345" Super Admin hisobini avtomatik yaratish.
# Productionda false qiling.
SEED_LEGACY_MENEJER=true

# ——— CORS ———
# Frontend manzillari, vergul bilan (*.vercel.app va localhost avtomatik ruxsat etilgan)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ——— AI yordamchi (Groq) ———
# Bepul kalit: https://console.groq.com/keys
# Bo'sh qoldirilsa yordamchi oflayn (rule-based) rejimda ishlaydi.
GROQ_API_KEY=
# Free Tier'da mavjud, tool calling'ni qo'llaydigan modellar:
#   openai/gpt-oss-120b  — eng aqlli (tavsiya etiladi)
#   openai/gpt-oss-20b   — tezroq, yengilroq
# Joriy ro'yxat: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
# Asosiy model limitga tushsa (429) yoki ishlamasa shu model ishlatiladi. Bo'sh = o'chiq.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=45
# GPT-OSS fikrlash darajasi: low | medium | high  (low — Free Tier tokenlarini tejaydi)
GROQ_REASONING_EFFORT=low
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.3

# ——— Google Sheets / Sayt integratsiyasi ———
# Har biriga tasodifiy qiymat bering:  openssl rand -hex 24
SHEETS_WEBHOOK_SECRET=change-me-sheets-secret
SHEETS_DEFAULT_SOURCE=Google Sheets
WEBSITE_WEBHOOK_SECRET=change-me-website-secret
WEBSITE_DEFAULT_SOURCE=Veb-sayt

# ——— AI Call Center (Groq) ———
# Yuqoridagi GROQ_API_KEY ishlatiladi — alohida kalit kerak emas.
# Oqim: audio → Groq Whisper (STT) → transcript → GROQ_MODEL (AI analiz).
GROQ_STT_MODEL=whisper-large-v3-turbo
# Suhbat tili (ISO-639-1). Bo'sh = avtomatik aniqlash.
GROQ_STT_LANGUAGE=uz
# Groq Free Tier STT fayl limiti (MB). Undan katta audio saqlanadi, lekin transcript qilinmaydi.
GROQ_STT_MAX_MB=25
GROQ_STT_TIMEOUT_SECONDS=180
# Analiz javobi token limiti va modelga yuboriladigan transcript hajmi (Free Tier ~8K token/daqiqa)
GROQ_CALL_MAX_TOKENS=2500
GROQ_CALL_TRANSCRIPT_CHARS=10000
# Audio yozuvlari papkasi (bo'sh = data/recordings) va yuklash limiti
RECORDINGS_DIR=
CALL_MAX_UPLOAD_MB=100

# ——— xAI / Grok (IXTIYORIY, eski moslik) ———
# Faqat GROQ_API_KEY bo'sh bo'lsa ishlatiladi. Call Center uchun MAJBURIY EMAS.
XAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=https://api.x.ai/v1
XAI_STT_MODEL=
XAI_STT_LANGUAGE=
XAI_TIMEOUT_SECONDS=180

# ——— Tizim ———
# Ma'lumotlar papkasi (bo'sh = backend/data). Render'da persistent diskka yo'naltiring.
DATA_DIR=
# true bo'lsa 500-xato tafsiloti API javobida ko'rinadi. Productionda false.
APP_DEBUG=false
